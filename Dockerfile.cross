# Cross-build picamera for aarch64 (Raspberry Pi) on an x86 host.
# Uses qemu-user-static binfmt_misc emulation — no real ARM hardware needed.
#
# Build:   docker build --platform linux/arm64 -t picamera-cross -f Dockerfile.cross .
# Extract: docker create --platform linux/arm64 --name pcx picamera-cross && \
#          docker cp pcx:/build/picamera ./picamera-arm64 && docker rm pcx
#
# Or just: ./scripts/cross-build.sh
#
# Uses Debian trixie + the Raspberry Pi apt archive so libcamera matches the
# Pi's installed version (0.7.x / libcamera.so.0.7), not plain Debian's 0.4.x.

FROM --platform=linux/arm64 debian:trixie

# Add the Raspberry Pi apt archive for libcamera 0.7.x.
# The keyring deb is fetched from the RPi repo and installed with dpkg.
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -qO /tmp/rpi-keyring.deb \
       https://archive.raspberrypi.com/debian/pool/main/r/raspberrypi-archive-keyring/raspberrypi-archive-keyring_2025.1+rpt1_all.deb \
    && dpkg -i /tmp/rpi-keyring.deb \
    && rm -f /tmp/rpi-keyring.deb \
    && echo "Types: deb\nURIs: http://archive.raspberrypi.com/debian/\nSuites: trixie\nComponents: main\nSigned-By: /usr/share/keyrings/raspberrypi-archive-keyring.pgp" \
       > /etc/apt/sources.list.d/raspi.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        libcamera-dev \
        libpng-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

RUN mkdir -p /build && cd /build && \
    cmake -DCMAKE_BUILD_TYPE=Release /src && \
    make -j"$(nproc)"

# The binary ends up at /build/picamera — extract with docker cp.
